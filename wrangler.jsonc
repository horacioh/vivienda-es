// Cloudflare Workers Builds: `bun run build` genera `dist/` y `wrangler deploy` lo publica
// como static assets. El Worker (`worker/index.ts`) solo atiende /api/* (respuestas anónimas
// del cuestionario, guardadas en D1).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vivienda-es",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vivienda-es",
      // ID de la base de datos D1 creada en el dashboard de Cloudflare.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  // Máximo de envíos por IP y minuto; la IP no se guarda.
  "ratelimits": [
    {
      "name": "LIMITE",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Necesario para que Workers Builds publique previews de las ramas que no son `main`
  // (`wrangler preview`).
  "previews": {}
}
