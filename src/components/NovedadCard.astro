---
import type { CollectionEntry } from "astro:content";
import { ESTADO_LABEL, TIPO_LABEL, dominio } from "../lib/novedades";
import VotoBarra from "./VotoBarra.astro";

interface Props {
  novedad: CollectionEntry<"novedades">;
}

const { novedad } = Astro.props;
const d = novedad.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const detalle = `${base}/novedades/${novedad.id}`;
---
<article
  class="novedad rounded-2xl bg-card p-4 shadow-card sm:p-5"
  style={`--tipo: var(--color-${d.tipo})`}
  data-tipo={d.tipo}
  data-partido={d.partido ?? ""}
>
  <div class="flex items-center gap-2">
    <span class="inline-flex items-center gap-1.5 text-[0.7rem] font-bold uppercase tracking-[0.1em] text-(--tipo)">
      <span class="size-2 rounded-full bg-(--tipo)" aria-hidden="true"></span>
      {TIPO_LABEL[d.tipo]}
    </span>
    {d.estado && <span class={`estado estado-${d.estado} ml-auto`}>{ESTADO_LABEL[d.estado]}</span>}
  </div>
  {(d.partido || d.institucion) && (
    <p class="mt-3 text-sm leading-snug text-muted">
      {d.partido && <span class="font-semibold text-ink">{d.partido}</span>}
      {d.partido && d.institucion && <span aria-hidden="true"> · </span>}
      {d.institucion}
    </p>
  )}
  <h3 class="mt-1.5 font-display text-[1.32rem] font-semibold leading-[1.22] tracking-[-0.01em] text-pretty sm:text-[1.45rem]">
    <a
      href={detalle}
      class="underline decoration-transparent decoration-[1.5px] underline-offset-[5px] transition-[text-decoration-color] duration-150 hover:decoration-(--tipo)"
    >{d.titulo}</a>
  </h3>
  <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-2 text-pretty">{d.resumen}</p>
  {d.resultado && <VotoBarra class="mt-4" si={d.resultado.si} no={d.resultado.no} abstencion={d.resultado.abstencion} />}
  <div class="mt-4 flex items-center gap-3 border-t border-line pt-1 text-sm">
    <a
      href={d.fuente_url}
      target="_blank"
      rel="noopener"
      class="inline-flex min-h-11 shrink-0 items-center gap-1 font-semibold text-accent-dark transition-colors hover:text-accent"
    >Ver fuente oficial →</a>
    <span class="min-w-0 truncate text-xs text-muted" title={d.fuente_nombre}>{dominio(d.fuente_url)}</span>
    <a href={detalle} class="ml-auto inline-flex min-h-11 shrink-0 items-center text-muted transition-colors hover:text-ink">Detalle</a>
  </div>
</article>
