---
import Base from "../layouts/Base.astro";
import { ACTORES, AFIRMACIONES, MATRIZ, totales, urlDatos, urlIniciativa } from "../lib/cuestionario";

const etiqueta = (v: number | null) =>
  v === null ? "sin" : v >= 0.5 ? "favor" : v <= -0.5 ? "contra" : "medio";
const TEXTO: Record<string, string> = { favor: "A favor", contra: "En contra", medio: "Abstención o dividido", sin: "Sin voto" };
const VOTO_CORTO: Record<string, string> = { "Sí": "Sí", No: "No", "Abstención": "Abst.", "No vota": "—" };

const datos = MATRIZ.map(({ afirmacion, posturas }) => ({
  id: afirmacion.id,
  corto: afirmacion.corto,
  posturas: Object.fromEntries(posturas.map((p) => [p.actor.id, p.valor])),
}));
const actores = ACTORES.map((a) => ({ id: a.id, nombre: a.nombre }));
const payload = JSON.stringify({ afirmaciones: datos, actores });
const valor = (i: number, actor: string) => MATRIZ[i].posturas.find((p) => p.actor.id === actor)?.valor ?? null;
const coincidencia = (x: string, y: string) =>
  MATRIZ.reduce((s, _, i) => {
    const a = valor(i, x), b = valor(i, y);
    return a === null || b === null ? s : s + 1 - Math.abs(a - b) / 2;
  }, 0);
const orden = [...ACTORES].sort((a, b) => coincidencia(a.id, "pp") - coincidencia(b.id, "pp"));
const COLUMNAS = [["contra", "En contra"], ["medio", "Abst. o dividido"], ["favor", "A favor"]] as const;
const fmtFecha = (iso: string) =>
  new Date(iso + "T12:00:00Z").toLocaleDateString("es-ES", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
---
<Base
  title="Elecciones 29N: vivienda"
  description="Compara lo que piensas sobre vivienda con lo que cada partido votó en el Congreso. Cada postura enlaza a la votación oficial."
>
  <section class="pb-6 pt-8 sm:pb-10 sm:pt-16">
    <p class="text-[0.72rem] font-bold uppercase tracking-[0.16em] text-accent">Elecciones generales · 29 de noviembre</p>
    <h1 class="mt-3 max-w-3xl font-display text-[2.4rem] font-semibold leading-[1.04] tracking-[-0.02em] text-balance sm:text-[3.75rem]">
      ¿Qué partido vota como tú en vivienda?
    </h1>
    <p class="mt-4 max-w-xl text-[1.05rem] leading-relaxed text-ink-2 text-pretty sm:text-lg">
      Responde {AFIRMACIONES.length} afirmaciones y te comparamos con lo que votó cada partido en el Congreso entre 2024 y 2026. Cada postura enlaza a su votación oficial. Tus respuestas no salen de tu navegador, salvo que decidas compartirlas de forma anónima.
    </p>
    <div class="mt-6 flex flex-wrap gap-2">
      <a href="#cuestionario" class="btn btn-primario">Empezar el cuestionario</a>
      <a href="#posturas" class="btn btn-secundario">Ver qué votó cada partido</a>
    </div>
  </section>

  <section id="cuestionario" class="scroll-mt-4" aria-label="Cuestionario">
    <noscript>
      <p class="rounded-2xl bg-card p-6 shadow-card">El cuestionario necesita JavaScript. Las posturas de cada partido están más abajo.</p>
    </noscript>
    <div id="q" class="rounded-[1.5rem] bg-card p-5 shadow-card sm:p-8" hidden>
      <div class="flex items-center justify-between gap-3 text-sm">
        <span id="q-tema" class="rounded-full bg-ink/5 px-2.5 py-1 text-xs font-semibold uppercase tracking-[0.08em] text-ink-2"></span>
        <span id="q-paso" class="font-medium tabular-nums text-muted"></span>
      </div>
      <div class="mt-3 h-1 overflow-hidden rounded-full bg-line" aria-hidden="true">
        <div id="q-barra" class="h-full w-0 rounded-full bg-accent transition-[width] duration-300 ease-out"></div>
      </div>
      <h2 id="q-texto" class="mt-6 min-h-[5.5rem] font-display text-[1.6rem] font-semibold leading-[1.15] tracking-[-0.01em] text-balance sm:min-h-[6rem] sm:text-[2.1rem]" tabindex="-1"></h2>
      <p id="q-contexto" class="mt-3 max-w-2xl text-[0.95rem] leading-relaxed text-muted text-pretty"></p>
      <div class="mt-6 grid gap-2 sm:grid-cols-3" role="group" aria-label="Tu respuesta">
        <button type="button" class="resp" data-valor="1"><span class="punto bg-si"></span>De acuerdo</button>
        <button type="button" class="resp" data-valor="0"><span class="punto bg-abst"></span>Neutral</button>
        <button type="button" class="resp" data-valor="-1"><span class="punto bg-no"></span>En desacuerdo</button>
      </div>
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <label class="inline-flex min-h-11 cursor-pointer items-center gap-2.5 text-sm font-medium text-ink-2">
          <input id="q-importa" type="checkbox" class="size-[1.1rem] accent-[var(--color-accent)]" />
          Esto me importa mucho <span class="text-muted">(cuenta doble)</span>
        </label>
        <div class="flex gap-1">
          <button type="button" id="q-atras" class="btn-texto">← Anterior</button>
          <button type="button" id="q-saltar" class="btn-texto">Saltar</button>
        </div>
      </div>
    </div>

    <div id="r" class="rounded-[1.5rem] bg-card p-5 shadow-card sm:p-8" hidden>
      <p class="text-[0.72rem] font-bold uppercase tracking-[0.16em] text-accent">Tu resultado</p>
      <h2 id="r-titulo" class="mt-2 font-display text-[1.9rem] font-semibold leading-[1.1] tracking-[-0.01em] text-balance sm:text-[2.4rem]" tabindex="-1">
        Coincidencia con lo que votó cada partido
      </h2>
      <p id="r-resumen" class="mt-2 text-sm text-muted text-pretty"></p>
      <ol id="r-lista" class="mt-6 space-y-2.5"></ol>
      <div class="mt-8 border-t border-line pt-6">
        <h3 class="font-display text-xl font-semibold tracking-[-0.01em]">Tema a tema</h3>
        <p class="mt-1 text-sm text-muted text-pretty">Cómo votó cada partido en cada afirmación. El recuadro marca tu respuesta.</p>
        <div class="mt-4 space-y-4">
          {MATRIZ.map(({ afirmacion: a }, i) => (
            <div class="tema" data-i={i}>
              <p class="flex items-baseline justify-between gap-3 text-sm font-semibold text-ink">
                <a href={`#af-${a.id}`} class="hover:underline hover:underline-offset-4">{a.corto}</a>
                <span class="tema-nota shrink-0 text-xs font-medium text-muted"></span>
              </p>
              <div class="tres">
                {COLUMNAS.map(([k, t]) => (
                  <div class={`col col-${k}`} data-col={k}>
                    <p class="ct"><span class={`marca m-${k}`} aria-hidden="true"></span>{t}<span class="tu-marca ml-auto" hidden>Tú</span></p>
                    <div class="flex flex-wrap gap-1">
                      {orden.filter((x) => etiqueta(valor(i, x.id)) === k).map((x) => <span class="chip">{x.corto ?? x.nombre}</span>)}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
      <div id="compartir" class="mt-8 rounded-2xl bg-paper p-4 sm:p-5">
        <p class="text-[0.95rem] font-semibold text-ink">¿Compartes tus respuestas de forma anónima?</p>
        <p class="mt-1 max-w-2xl text-sm leading-relaxed text-muted text-pretty">
          Solo se guardan tus respuestas y el día: ni tu IP, ni cookies, ni nada que te identifique. Con ellas mostramos <a href="#opiniones" class="underline underline-offset-2">qué responde la gente</a>.
        </p>
        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
          <button type="button" id="r-compartir" class="btn btn-primario">Compartir de forma anónima</button>
          <p id="r-compartir-estado" class="text-sm font-medium text-ink-2 text-pretty" role="status"></p>
        </div>
      </div>
      <p class="mt-6 max-w-2xl text-[0.9rem] leading-relaxed text-muted text-pretty">
        Esto mide coincidencia con votos pasados en el Congreso, no con los programas del 29N, y no es una recomendación de voto. Abajo puedes ver cada votación y su fuente.
      </p>
      <div class="mt-5 flex flex-wrap gap-2">
        <a href="#posturas" class="btn btn-primario">Ver el detalle por tema</a>
        <button type="button" id="r-repetir" class="btn btn-secundario">Volver a empezar</button>
      </div>
    </div>
  </section>

  <section id="posturas" class="scroll-mt-4 pt-14 sm:pt-20" aria-labelledby="t-posturas">
    <h2 id="t-posturas" class="font-display text-[1.75rem] font-semibold tracking-[-0.01em] sm:text-[2.25rem]">Qué votó cada partido</h2>
    <p class="mt-2 max-w-2xl text-ink-2 text-pretty">
      Una tarjeta por afirmación. El color y el símbolo dicen si el partido votó a favor o en contra de lo que dice la afirmación; abre «Votaciones y fuentes» para ver cada voto y el documento oficial.
    </p>
    <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1.5 text-xs font-medium text-ink-2" aria-label="Leyenda">
      {["favor", "contra", "medio", "sin"].map((k) => <li class="inline-flex items-center gap-1.5"><span class={`marca m-${k}`} aria-hidden="true"></span>{TEXTO[k]}</li>)}
      <li id="leyenda-tu" class="inline-flex items-center gap-1.5" hidden><span class="tu-marca">Tú</span>Tu respuesta</li>
    </ul>

    <div class="mt-6 rounded-[1.25rem] bg-card p-4 shadow-card sm:p-6">
      <h3 class="font-display text-xl font-semibold tracking-[-0.01em]">De un vistazo</h3>
      <p class="mt-1 text-sm text-muted text-pretty">Una fila por partido, una columna por afirmación. Ordenados de menos a más coincidencia con el PP. Toca una casilla para ver sus votaciones.</p>
      <div class="-mx-1 mt-3 overflow-x-auto px-1">
        <table class="mapa">
          <thead>
            <tr><td></td>{MATRIZ.map(({ afirmacion: a }) => <th scope="col"><span>{a.corto}</span></th>)}</tr>
          </thead>
          <tbody>
            {orden.map((x) => (
              <tr>
                <th scope="row">{x.corto ?? x.nombre}</th>
                {MATRIZ.map(({ afirmacion: a }, i) => {
                  const k = etiqueta(valor(i, x.id));
                  return (
                    <td>
                      <a href={`#af-${a.id}`} class={`casilla m-${k}`} title={`${x.nombre} · ${a.corto}: ${TEXTO[k]}`}>
                        <span class="sr-only">{x.nombre}, {a.corto}: {TEXTO[k]}</span>
                      </a>
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-6 space-y-4">
      {MATRIZ.map(({ afirmacion: a, posturas }) => (
        <article id={`af-${a.id}`} class="afirmacion rounded-[1.25rem] bg-card p-5 shadow-card sm:p-6" data-id={a.id}>
          <div class="flex items-start justify-between gap-3">
            <p class="text-xs font-semibold uppercase tracking-[0.08em] text-muted">{a.tema}</p>
            <p class="tu-resp hidden shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold"></p>
          </div>
          <h3 class="mt-1.5 font-display text-[1.2rem] font-semibold leading-snug tracking-[-0.005em] text-balance sm:text-[1.35rem]">{a.texto}</h3>
          <ul class="mt-4 grid grid-cols-2 gap-1.5 sm:grid-cols-4 lg:grid-cols-6">
            {posturas.map((p) => {
              const k = etiqueta(p.valor);
              return (
                <li class={`celda c-${k}`} data-actor={p.actor.id} title={`${p.actor.nombre}: ${TEXTO[k]}`}>
                  <span class={`marca m-${k}`} aria-hidden="true"></span>
                  <span class="truncate">{p.actor.corto ?? p.actor.nombre}</span>
                  <span class="sr-only">: {TEXTO[k]}</span>
                </li>
              );
            })}
          </ul>
          <details class="group mt-4">
            <summary class="inline-flex min-h-10 cursor-pointer list-none items-center gap-1.5 text-sm font-semibold text-accent hover:text-accent-dark">
              Votaciones y fuentes ({a.evidencias.length})
              <svg class="size-4 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5.5 8 4.5 4.5L14.5 8"/></svg>
            </summary>
            <p class="mt-2 text-sm leading-relaxed text-ink-2 text-pretty">{a.contexto}</p>
            {a.evidencias.map((e, i) => {
              const t = totales(e.votacion);
              return (
                <div class="mt-4 border-t border-line pt-4">
                  <p class="text-sm font-semibold text-ink">
                    <time datetime={e.fecha}>{fmtFecha(e.fecha)}</time> · {e.iniciativa}
                  </p>
                  <p class="mt-0.5 text-sm text-muted">
                    {e.que_se_voto} {t && <span class="tabular-nums">Resultado: {t.si} sí, {t.no} no, {t.abstencion} abst.</span>}
                  </p>
                  <ul class="mt-2.5 flex flex-wrap gap-1.5 text-xs">
                    {posturas.map((p) => {
                      const ev = p.evidencias[i];
                      const n = Object.values(ev.recuento).reduce((s, x) => s + (x ?? 0), 0);
                      const desglose = Object.entries(ev.recuento).map(([k, v]) => `${v} ${k.toLowerCase()}`).join(", ");
                      return (
                        <li class={`voto v-${ev.voto ? ev.voto.replace(/\s/g, "") : "nada"}`} title={desglose}>
                          {p.actor.corto ?? p.actor.nombre} <b>{ev.voto ? VOTO_CORTO[ev.voto] : "—"}</b>{!ev.unanime && n > 1 && <span class="text-muted"> (dividido)</span>}
                        </li>
                      );
                    })}
                  </ul>
                  <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm font-semibold">
                    {e.texto_url && <a class="enlace" href={e.texto_url} target="_blank" rel="noopener">Texto oficial →</a>}
                    <a class="enlace" href={urlIniciativa(e.expediente)} target="_blank" rel="noopener">Ficha en el Congreso ({e.expediente}) →</a>
                    <a class="enlace" href={urlDatos(e.votacion)} target="_blank" rel="noopener">Votación (datos abiertos) →</a>
                  </p>
                </div>
              );
            })}
          </details>
        </article>
      ))}
    </div>
  </section>

  <section id="opiniones" class="scroll-mt-4 pt-14 sm:pt-20" aria-labelledby="t-opiniones" hidden>
    <h2 id="t-opiniones" class="font-display text-[1.75rem] font-semibold tracking-[-0.01em] sm:text-[2.25rem]">Qué responde la gente</h2>
    <p class="mt-2 max-w-2xl text-[0.95rem] leading-relaxed text-ink-2 text-pretty">
      Respuestas que han compartido de forma anónima quienes hicieron el cuestionario. <b class="text-ink">No es una encuesta:</b> responde quien quiere, así que no representa a la población.
    </p>
    <div class="mt-5 rounded-[1.25rem] bg-card p-4 shadow-card sm:p-6">
      <p id="op-estado" class="text-sm text-muted text-pretty"></p>
      <div id="op-lista" class="space-y-4 empty:hidden [&:not(:empty)]:mt-4"></div>
    </div>
  </section>

  <section id="metodo" class="pt-14 sm:pt-20" aria-labelledby="t-metodo">
    <h2 id="t-metodo" class="font-display text-[1.5rem] font-semibold tracking-[-0.01em] sm:text-[1.9rem]">Cómo se calcula</h2>
    <div class="mt-4 grid gap-4 text-[0.95rem] leading-relaxed text-ink-2 sm:grid-cols-2">
      <div class="space-y-3 text-pretty">
        <p><b class="text-ink">Qué se compara.</b> Cada afirmación resume una iniciativa votada en el Pleno del Congreso en la XV legislatura. La postura de un partido es lo que votó la mayoría de sus diputados: a favor cuenta +1, en contra −1 y abstención 0. Si hay varias votaciones sobre lo mismo, se hace la media.</p>
        <p><b class="text-ink">La puntuación.</b> En cada afirmación, coincidir del todo da 100 % y lo contrario 0 %; neutral frente a un voto a favor o en contra da 50 %. «Me importa mucho» cuenta doble. Las afirmaciones que saltas, o en las que un partido no votó, no cuentan.</p>
      </div>
      <div class="space-y-3 text-pretty">
        <p><b class="text-ink">Grupo Mixto.</b> Belarra, Santana, Sánchez Serna y Velarde (elegidos en la lista de SUMAR), BNG, Coalición Canaria y UPN no tienen grupo propio: se usa el voto de sus diputados, según los datos abiertos del Congreso.</p>
        <p><b class="text-ink">Límites.</b> Un voto no recoge todos los matices de una postura y los partidos votan a veces por motivos tácticos. Faltan los programas del 29N: los añadiremos, enlazados a la web oficial de cada partido, cuando se publiquen.</p>
        <p><b class="text-ink">Respuestas compartidas.</b> Si compartes tus respuestas, se guardan solo ellas y el día, sin IP, cookies ni identificador; la IP se usa en el momento para frenar envíos repetidos y no se guarda. Los porcentajes se muestran a partir de 30 cuestionarios y no se publican del 24 de noviembre al cierre de los colegios el 29, como marca la ley electoral para los sondeos.</p>
      </div>
    </div>
  </section>

  <script type="application/json" id="datos-cuestionario" set:html={payload} />
  <script>
    import "../scripts/cuestionario.ts";
  </script>
</Base>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.15rem;
    border-radius: 9999px;
    font-size: 0.95rem;
    font-weight: 600;
    transition-property: background-color, color, box-shadow, scale;
    transition-duration: 150ms;
  }
  .btn:active { scale: 0.96; }
  .btn-primario { background: var(--color-ink); color: var(--color-paper); }
  .btn-primario:hover { background: #000; }
  .btn-secundario { background: var(--color-card); color: var(--color-ink); box-shadow: var(--shadow-card); }
  .btn-secundario:hover { background: #fff; }
  .btn-texto {
    min-height: 2.75rem;
    padding: 0 0.85rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-muted);
    transition-property: background-color, color, scale;
    transition-duration: 150ms;
  }
  .btn-texto:hover { background: rgb(23 20 15 / 0.05); color: var(--color-ink); }
  .btn-texto:active { scale: 0.96; }
  .btn-texto:disabled { opacity: 0.35; pointer-events: none; }
  .resp {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 3.5rem;
    border-radius: 1rem;
    background: var(--color-paper);
    box-shadow: inset 0 0 0 1px var(--color-line);
    font-weight: 600;
    color: var(--color-ink);
    transition-property: background-color, box-shadow, color, scale;
    transition-duration: 150ms;
  }
  .resp:hover { background: #fff; box-shadow: inset 0 0 0 1px rgb(23 20 15 / 0.2); }
  .resp:active { scale: 0.96; }
  .resp[aria-pressed="true"] { background: var(--color-ink); color: var(--color-paper); box-shadow: none; }
  .resp:focus-visible, .btn:focus-visible, .btn-texto:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .punto { width: 0.6rem; height: 0.6rem; border-radius: 9999px; }
  .marca, .casilla { display: inline-grid; place-items: center; flex-shrink: 0; color: #fff; font-weight: 800; line-height: 1; }
  .marca { width: 1rem; height: 1rem; border-radius: 9999px; font-size: 0.62rem; }
  .m-favor { background: var(--color-si); }
  .m-contra { background: var(--color-no); }
  .m-medio { background: var(--color-abst); color: var(--color-ink); }
  .m-sin { background: repeating-linear-gradient(45deg, var(--color-line) 0 2px, transparent 2px 5px); box-shadow: inset 0 0 0 1px var(--color-line); }
  .m-favor::after { content: "✓"; }
  .m-contra::after { content: "✕"; }
  .m-medio::after { content: "–"; }
  .mapa { border-collapse: separate; border-spacing: 3px; margin-left: -3px; }
  .mapa thead th { height: 9.25rem; padding: 0 0 0.3rem; vertical-align: bottom; }
  .mapa thead th span { display: inline-block; writing-mode: vertical-rl; transform: rotate(180deg); font-size: 0.72rem; font-weight: 600; white-space: nowrap; color: var(--color-ink-2); }
  .mapa tbody th { padding-right: 0.4rem; text-align: right; font-size: 0.75rem; font-weight: 600; white-space: nowrap; }
  .mapa td { padding: 0; }
  .casilla { width: 1.6rem; height: 1.75rem; border-radius: 0.45rem; font-size: 0.85rem; transition-property: scale; transition-duration: 120ms; }
  .casilla:hover { scale: 1.08; }
  .casilla:active { scale: 0.96; }
  .casilla:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 1px; }
  @media (min-width: 640px) { .casilla { width: 2.6rem; height: 2rem; font-size: 0.95rem; } .mapa thead th span { font-size: 0.78rem; } .mapa tbody th { font-size: 0.8rem; padding-right: 0.5rem; } }
  .tres { margin-top: 0.4rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.35rem; }
  .col { position: relative; min-height: 3.25rem; padding: 0.5rem; border-radius: 0.75rem; background: rgb(23 20 15 / 0.035); }
  .col-contra { background: color-mix(in oklab, var(--color-no) 8%, var(--color-card)); }
  .col-favor { background: color-mix(in oklab, var(--color-si) 8%, var(--color-card)); }
  .col.mia { box-shadow: inset 0 0 0 2px var(--color-ink); }
  .ct { display: flex; align-items: center; gap: 0.35rem; margin-bottom: 0.4rem; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ink-2); }
  .col .tu-marca { position: absolute; top: -0.55rem; right: 0.35rem; }
  .ct .marca { width: 0.85rem; height: 0.85rem; font-size: 0.52rem; }
  .chip { padding: 0.1rem 0.45rem; border-radius: 9999px; background: var(--color-card); box-shadow: 0 0 0 1px rgb(23 20 15 / 0.1); max-width: 100%; font-size: 0.72rem; font-weight: 600; overflow-wrap: anywhere; color: var(--color-ink); }
  .celda {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    min-height: 2.5rem;
    padding: 0 0.7rem;
