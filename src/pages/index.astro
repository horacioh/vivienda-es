---
import { getCollection } from "astro:content";
import NovedadCard from "../components/NovedadCard.astro";
import Base from "../layouts/Base.astro";
import { TIPOS, TIPO_LABEL, fechaLarga, isoDia } from "../lib/novedades";

const novedades = (await getCollection("novedades")).sort(
  (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime() || b.id.localeCompare(a.id),
);

const porDia = new Map<string, typeof novedades>();
for (const n of novedades) {
  const k = isoDia(n.data.fecha);
  porDia.set(k, [...(porDia.get(k) ?? []), n]);
}

const partidos = [...new Set(novedades.map((n) => n.data.partido).filter((p): p is string => !!p))].sort((a, b) =>
  a.localeCompare(b, "es"),
);
const tiposPresentes = TIPOS.filter((t) => novedades.some((n) => n.data.tipo === t));
const ultima = novedades[0]?.data.fecha;
---
<Base
  title="Vivienda ES"
  description="Novedades diarias sobre vivienda en España: leyes, propuestas por partido, votaciones y aprobaciones, siempre con enlace a la fuente oficial."
>
  <section class="pb-4 pt-6 sm:pt-10">
    <h1 class="text-[1.65rem] font-bold leading-tight tracking-tight text-balance sm:text-4xl">
      Vivienda en España, día a día
    </h1>
    <p class="mt-2 max-w-prose text-[0.98rem] leading-relaxed text-muted sm:text-lg">
      Leyes, propuestas, votaciones y aprobaciones sobre vivienda, cada una con su enlace a la fuente oficial.
    </p>
    {ultima && (
      <p class="mt-3 text-sm text-muted">
        {novedades.length} novedades · última: <time datetime={isoDia(ultima)}>{fechaLarga(ultima)}</time>
      </p>
    )}
  </section>

  <form id="filtros" class="sticky top-0 z-10 -mx-4 border-b border-line bg-paper/95 px-4 py-3 backdrop-blur sm:-mx-6 sm:px-6" aria-label="Filtros">
    <fieldset>
      <legend class="sr-only">Tipo</legend>
      <div class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 [scrollbar-width:none] sm:mx-0 sm:flex-wrap sm:px-0">
        <label class="chip"><input type="radio" name="tipo" value="" checked class="sr-only" /><span>Todo</span></label>
        {tiposPresentes.map((t) => (
          <label class="chip"><input type="radio" name="tipo" value={t} class="sr-only" /><span>{TIPO_LABEL[t]}</span></label>
        ))}
      </div>
    </fieldset>
    <div class="mt-2 flex items-center gap-2">
      <label for="partido" class="text-sm text-muted">Partido</label>
      <select id="partido" name="partido" class="min-h-10 min-w-0 flex-1 rounded-lg border border-line bg-white px-3 text-sm sm:max-w-xs">
        <option value="">Todos los partidos</option>
        {partidos.map((p) => <option value={p}>{p}</option>)}
      </select>
      <span id="contador" class="ml-auto shrink-0 text-sm tabular-nums text-muted" aria-live="polite"></span>
    </div>
  </form>

  <div id="feed" class="mt-2">
    {[...porDia].map(([diaIso, items]) => (
      <section class="dia pt-6" data-dia={diaIso} aria-labelledby={`d-${diaIso}`}>
        <h2 id={`d-${diaIso}`} class="mb-3 flex items-center gap-3 text-sm font-semibold text-muted">
          <span class="size-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
          <time datetime={diaIso}>{fechaLarga(items[0].data.fecha)}</time>
        </h2>
        <div class="ml-1 space-y-3 border-l-2 border-line pl-4 sm:pl-6">
          {items.map((n) => <NovedadCard novedad={n} />)}
        </div>
      </section>
    ))}
    <p id="vacio" class="py-12 text-center text-muted" hidden>No hay novedades con estos filtros.</p>
  </div>
  <script>
    import "../scripts/filtros.ts";
  </script>
</Base>

<style>
  .chip {
    display: inline-flex;
    flex-shrink: 0;
    cursor: pointer;
  }
  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 0.9rem;
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    background: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-muted);
    transition: background-color 120ms, color 120ms, border-color 120ms;
  }
  .chip input:checked + span {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: #fff;
  }
  .chip input:focus-visible + span {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
