---
import { getCollection } from "astro:content";
import NovedadCard from "../components/NovedadCard.astro";
import Base from "../layouts/Base.astro";
import { TIPOS, TIPO_LABEL, fechaDiaMes, isoDia, partesDia } from "../lib/novedades";

const novedades = (await getCollection("novedades")).sort(
  (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime() || b.id.localeCompare(a.id),
);

const porDia = new Map<string, typeof novedades>();
for (const n of novedades) {
  const k = isoDia(n.data.fecha);
  porDia.set(k, [...(porDia.get(k) ?? []), n]);
}

const partidos = [...new Set(novedades.map((n) => n.data.partido).filter((p): p is string => !!p))].sort((a, b) =>
  a.localeCompare(b, "es"),
);
const tiposPresentes = TIPOS.filter((t) => novedades.some((n) => n.data.tipo === t));
const cuenta = (t: string) => novedades.filter((n) => n.data.tipo === t).length;
const ultima = novedades[0]?.data.fecha;
---
<Base
  title="Vivienda ES"
  description="Novedades diarias sobre vivienda en España: leyes, propuestas por partido, votaciones y aprobaciones, siempre con enlace a la fuente oficial."
>
  <section class="pb-8 pt-8 sm:pb-12 sm:pt-16">
    <p class="text-[0.72rem] font-bold uppercase tracking-[0.16em] text-accent">Boletín diario · Solo fuentes oficiales</p>
    <h1 class="mt-3 font-display text-[2.6rem] font-semibold leading-[1.02] tracking-[-0.02em] text-balance sm:text-[4.25rem]">
      La vivienda en España, <em class="text-accent">día a día</em>
    </h1>
    <p class="mt-4 max-w-xl text-[1.05rem] leading-relaxed text-ink-2 text-pretty sm:mt-5 sm:text-lg">
      Leyes, propuestas de cada partido, votaciones en el Parlamento y aprobaciones del Gobierno. Cada dato enlaza a su documento original.
    </p>
    <dl class="mt-7 grid max-w-xl grid-cols-3 divide-x divide-line rounded-2xl bg-card shadow-card">
      <div class="px-4 py-3">
        <dt class="text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-muted">Novedades</dt>
        <dd class="mt-0.5 font-display text-2xl font-semibold tabular-nums">{novedades.length}</dd>
      </div>
      <div class="px-4 py-3">
        <dt class="text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-muted">Última</dt>
        <dd class="mt-0.5 font-display text-2xl font-semibold tabular-nums">{ultima && <time datetime={isoDia(ultima)}>{fechaDiaMes(ultima)}</time>}</dd>
      </div>
      <div class="px-4 py-3">
        <dt class="text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-muted">Partidos</dt>
        <dd class="mt-0.5 font-display text-2xl font-semibold tabular-nums">{partidos.length}</dd>
      </div>
    </dl>
  </section>

  <form
    id="filtros"
    class="sticky top-0 z-20 -mx-4 border-y border-line bg-paper/85 px-4 py-3 backdrop-blur-md sm:-mx-6 sm:px-6"
    aria-label="Filtros"
  >
    <div class="flex flex-col gap-2.5 sm:flex-row sm:items-center sm:gap-4">
      <fieldset class="min-w-0 sm:flex-1">
        <legend class="sr-only">Tipo de novedad</legend>
        <div class="chips -mx-4 flex gap-1.5 overflow-x-auto px-4 [scrollbar-width:none] sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0">
          <label class="chip"><input type="radio" name="tipo" value="" checked class="sr-only" /><span>Todo <b>{novedades.length}</b></span></label>
          {tiposPresentes.map((t) => (
            <label class="chip" style={`--tipo: var(--color-${t})`}>
              <input type="radio" name="tipo" value={t} class="sr-only" />
              <span><i aria-hidden="true"></i>{TIPO_LABEL[t]} <b>{cuenta(t)}</b></span>
            </label>
          ))}
        </div>
      </fieldset>
      <div class="flex items-center gap-2">
        <div class="relative min-w-0 flex-1 sm:w-56 sm:flex-none">
          <label for="partido" class="sr-only">Partido</label>
          <select
            id="partido"
            name="partido"
            class="h-10 w-full cursor-pointer appearance-none rounded-full bg-card pl-4 pr-9 text-sm font-medium text-ink shadow-card"
          >
            <option value="">Todos los partidos</option>
            {partidos.map((p) => <option value={p}>{p}</option>)}
          </select>
          <svg class="pointer-events-none absolute right-3.5 top-1/2 size-4 -translate-y-1/2 text-muted" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5.5 8 4.5 4.5L14.5 8"/></svg>
        </div>
        <button
          type="button"
          id="limpiar"
          hidden
          class="h-10 shrink-0 rounded-full px-3 text-sm font-medium text-muted transition-[color,background-color,scale] hover:bg-ink/5 hover:text-ink active:scale-[0.96]"
        >Quitar filtros</button>
      </div>
    </div>
  </form>

  <p id="contador" class="mt-5 text-xs font-medium uppercase tracking-[0.1em] text-muted tabular-nums" aria-live="polite"></p>

  <div id="feed">
    {[...porDia].map(([diaIso, items]) => {
      const p = partesDia(items[0].data.fecha);
      return (
        <section class="dia grid gap-3 pt-6 sm:grid-cols-[7rem_1fr] sm:gap-8 sm:pt-10" data-dia={diaIso} aria-labelledby={`d-${diaIso}`}>
          <h2 id={`d-${diaIso}`} class="sm:sticky sm:top-24 sm:self-start">
            <time datetime={diaIso} class="flex items-baseline gap-2 sm:flex-col sm:gap-1">
              <span class="font-display text-[1.9rem] font-semibold leading-none tabular-nums sm:text-5xl">{p.dia}</span>
              <span class="text-sm font-semibold text-ink">{p.mes} {p.anio}</span>
              <span class="text-sm text-muted"><span class="sm:hidden" aria-hidden="true">· </span>{p.semana}</span>
              <span class="ml-1 h-px flex-1 self-center bg-line sm:hidden" aria-hidden="true"></span>
            </time>
          </h2>
          <div class="min-w-0 space-y-3">
            {items.map((n) => <NovedadCard novedad={n} />)}
          </div>
        </section>
      );
    })}
    <div id="vacio" class="mt-6 rounded-2xl bg-card px-6 py-14 text-center shadow-card" hidden>
      <p class="font-display text-xl font-semibold">No hay novedades con estos filtros.</p>
      <p class="mt-1 text-sm text-muted">Prueba con otro partido o tipo.</p>
    </div>
  </div>
  <script>
    import "../scripts/filtros.ts";
  </script>
</Base>

<style>
  .chips {
    mask-image: linear-gradient(to right, #000 calc(100% - 2rem), transparent);
  }
  @media (min-width: 640px) {
    .chips {
      mask-image: none;
    }
  }
  .chip {
    display: inline-flex;
    flex-shrink: 0;
    cursor: pointer;
  }
  .chip span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.5rem;
    padding: 0 0.85rem;
    border-radius: 9999px;
    background: var(--color-card);
    box-shadow: var(--shadow-card);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink-2);
    white-space: nowrap;
    transition-property: background-color, color, box-shadow, scale;
    transition-duration: 150ms;
  }
  .chip:active span {
    scale: 0.96;
  }
  .chip i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 9999px;
    background: var(--tipo);
  }
  .chip b {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }
  .chip input:checked + span {
    background: var(--color-ink);
    color: var(--color-paper);
    box-shadow: none;
  }
  .chip input:checked + span b {
    color: rgb(247 244 238 / 0.6);
  }
  .chip input:checked + span i {
    box-shadow: 0 0 0 2px var(--color-ink), 0 0 0 3px rgb(255 255 255 / 0.5);
  }
  .chip input:focus-visible + span {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
