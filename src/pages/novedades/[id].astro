---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { ESTADO_LABEL, TIPO_LABEL, fechaLarga, isoDia } from "../../lib/novedades";

export async function getStaticPaths() {
  const novedades = await getCollection("novedades");
  return novedades.map((novedad) => ({ params: { id: novedad.id }, props: { novedad } }));
}

interface Props {
  novedad: CollectionEntry<"novedades">;
}

const { novedad } = Astro.props;
const d = novedad.data;
const { Content } = await render(novedad);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const filas = [
  ["Fecha", fechaLarga(d.fecha)],
  ["Tipo", TIPO_LABEL[d.tipo]],
  ["Partido", d.partido],
  ["Institución", d.institucion],
  ["Estado", d.estado && ESTADO_LABEL[d.estado]],
  ["Fuente", d.fuente_nombre],
].filter((f): f is [string, string] => !!f[1]);
---
<Base title={d.titulo} description={d.resumen}>
  <nav class="pt-5 text-sm"><a href={`${base}/`} class="text-muted hover:text-ink hover:underline underline-offset-4">← Todas las novedades</a></nav>
  <article class="pt-4">
    <p class="text-sm text-muted"><time datetime={isoDia(d.fecha)}>{fechaLarga(d.fecha)}</time> · {TIPO_LABEL[d.tipo]}</p>
    <h1 class="mt-1 text-2xl font-bold leading-tight tracking-tight text-balance sm:text-3xl">
      <a href={d.fuente_url} target="_blank" rel="noopener" class="hover:underline underline-offset-4 decoration-accent/40">{d.titulo}</a>
    </h1>
    <p class="mt-3 text-lg leading-relaxed text-ink/85">{d.resumen}</p>

    <a href={d.fuente_url} target="_blank" rel="noopener" class="mt-5 inline-flex min-h-12 w-full items-center justify-center rounded-lg bg-accent px-5 font-semibold text-white hover:bg-accent-dark sm:w-auto">
      Ver fuente oficial →
    </a>

    <dl class="mt-6 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 rounded-xl border border-line bg-white p-4 text-sm">
      {filas.map(([k, v]) => (<><dt class="text-muted">{k}</dt><dd class="font-medium">{v}</dd></>))}
      <dt class="text-muted">Enlace</dt>
      <dd class="min-w-0 break-all"><a href={d.fuente_url} target="_blank" rel="noopener" class="text-accent-dark underline underline-offset-4">{d.fuente_url}</a></dd>
    </dl>

    {d.resultado && (
      <section class="mt-6">
        <h2 class="text-base font-semibold">Resultado</h2>
        <p class="mt-1 tabular-nums">{d.resultado.si} sí · {d.resultado.no} no · {d.resultado.abstencion} abstenciones</p>
      </section>
    )}
    {d.votos_por_grupo && (
      <section class="mt-6">
        <h2 class="text-base font-semibold">Votos por grupo</h2>
        <div class="mt-2 overflow-x-auto rounded-xl border border-line bg-white">
          <table class="w-full text-sm tabular-nums">
            <thead class="text-left text-muted"><tr><th class="p-2 pl-4 font-medium">Grupo</th><th class="p-2 font-medium">Sí</th><th class="p-2 font-medium">No</th><th class="p-2 pr-4 font-medium">Abst.</th></tr></thead>
            <tbody>
              {d.votos_por_grupo.map((v) => (
                <tr class="border-t border-line"><td class="p-2 pl-4">{v.grupo}</td><td class="p-2">{v.si}</td><td class="p-2">{v.no}</td><td class="p-2 pr-4">{v.abstencion}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}
    <div class="prose-novedad mt-6 leading-relaxed"><Content /></div>
  </article>
</Base>
